# Copy this file to .env and fill in real values. Never commit the real .env file.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# SQLite is used automatically when DATABASE_URL is not set (fine for a first run
# and for very small deployments). For production, point this at PostgreSQL:
# DATABASE_URL=postgres://titans_user:titans_password@localhost:5432/titans_crm
DATABASE_URL=

TIME_ZONE=Asia/Kolkata

SESSION_COOKIE_AGE=36000

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
