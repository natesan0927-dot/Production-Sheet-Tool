# Copy this file to .env and fill in real values. Never commit the real .env file.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# SQLite is used automatically when DATABASE_URL is not set (fine for a first run
# and for very small deployments). For production, point this at PostgreSQL:
# DATABASE_URL=postgres://titans_user:titans_password@localhost:5432/titans_crm
DATABASE_URL=

TIME_ZONE=Asia/Kolkata

# Optional: your own Super Admin login, created the first time seed_data runs.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# Only for a database that still holds the previous version's tables:
# set to true for one deploy to delete them and start fresh. See README.
RESET_LEGACY_SCHEMA=

# Signed in until the device has gone this long unused (seconds; 172800 = 48 hours).
SESSION_COOKIE_AGE=172800

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# --- HTTPS hardening -------------------------------------------------------
# Leave HSTS at 0 until the certificate is working and the site has been used
# over HTTPS for a day or two. Turning it on early locks browsers out for the
# full duration.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# --- Uploaded documents ----------------------------------------------------
# Leave these blank and files are written to media/ on the server's own disk,
# which is right for any host with a permanent disk (Oracle Cloud, a VPS,
# PythonAnywhere). Set them to use an S3-compatible bucket instead — Cloudflare
# R2, Supabase Storage, Backblaze B2 — which is what makes a host with no
# permanent disk, such as Render's free plan, usable.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
# "virtual" for Cloudflare R2 and Backblaze B2, "path" for Supabase Storage.
AWS_S3_ADDRESSING_STYLE=virtual
